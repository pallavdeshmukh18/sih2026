# MediKiosk Express Backend Environment Variables
PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/medikiosk
JWT_SECRET=your_jwt_secret_key_here
ML_SERVICE_URL=http://localhost:8000
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PROFILE_PHOTOS_BUCKET=profile-photos

# Production requires a trusted database certificate. Enable verification in development once its CA is configured.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Set DATABASE_SSL=disable only for a local PostgreSQL instance.
DATABASE_SSL=require
# Optional PEM CA certificate for your database provider.
DATABASE_SSL_CA=
# Same random secret in backend and ML; required for remotely hosted ML.
ML_SERVICE_KEY=
# Optional development-only local file storage. Production uses Supabase.
DOCUMENT_STORAGE_PROVIDER=supabase
# Comma-separated user UUIDs allowed to verify doctors (not clinic staff roles).
PLATFORM_ADMIN_USER_IDS=
WHATSAPP_SERVICE_KEY=
OTP_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

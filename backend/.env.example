# MediKiosk Backend Environment Variables
PORT=5001

# PostgreSQL / Supabase Connection URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/patient/google/callback

# 2Factor.in SMS API Key
TWOFACTOR_API_KEY=

# Gmail SMTP Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=

# OTP Configuration
OTP_SECRET=

# Node Environment (development / production)
NODE_ENV=development

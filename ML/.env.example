# MediKiosk Fast-API ML & Intelligence Service Environment Variables
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3

# Bhashini Speech Services (Standalone STT & TTS)
BHASHINI_UDYAT_API_KEY=your_udyat_key
BHASHINI_INFERENCE_API_KEY=your_inference_key
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Bhashini ASR Service IDs (per language)
BHASHINI_ASR_SERVICE_ID_HI=your_asr_service_id_hi_here
BHASHINI_ASR_SERVICE_ID_MR=your_asr_service_id_mr_here
BHASHINI_ASR_SERVICE_ID_EN=your_asr_service_id_en_here

# Bhashini TTS Service IDs (per language)
BHASHINI_TTS_SERVICE_ID_HI=your_tts_service_id_hi_here
BHASHINI_TTS_SERVICE_ID_MR=your_tts_service_id_mr_here
BHASHINI_TTS_SERVICE_ID_EN=your_tts_service_id_en_here
